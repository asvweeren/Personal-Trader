# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Interactive Brokers
IBKR_HOST=ib-gateway
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=true
ENABLE_EU_TRADING=false  # Set true when IBKR has EU market data subscriptions

# IB Gateway Docker (used by ib-gateway container)
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_TRADING_MODE=paper
VNC_PASSWORD=change_me_vnc_password

# Claude API (for sentiment analysis)
ANTHROPIC_API_KEY=your-api-key-here

# News API
NEWS_API_KEY=your-newsapi-key-here

# Alerts - Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_IDS=your-chat-id

# Alerts - Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=your-email@gmail.com

# Trading Configuration
INITIAL_CAPITAL=5000.0
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_PCT=20.0
MAX_OPEN_POSITIONS=10
MIN_CASH_RESERVE_PCT=30.0

# Domain (for SSL certificate)
DOMAIN=trader.yourdomain.com

# IP Whitelist
# Edit nginx/ip-whitelist.conf to restrict dashboard access to specific IPs.
# Then restart nginx: docker compose -f docker-compose.prod.yml restart nginx
