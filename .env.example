# Application
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Interactive Brokers
IBKR_HOST=ib-gateway
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_TRADING=true

# IB Gateway Docker (used by ib-gateway container)
IBKR_USERNAME=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_TRADING_MODE=paper
VNC_PASSWORD=change_me_vnc_password

# Claude API (for sentiment analysis)
ANTHROPIC_API_KEY=your-api-key-here

# News API
NEWS_API_KEY=your-newsapi-key-here

# Alerts - Signal CLI REST API
SIGNAL_CLI_REST_API_URL=http://signal-cli-rest-api:8080
SIGNAL_SENDER_NUMBER=+31600000000
SIGNAL_RECIPIENT_NUMBERS=+31600000001

# Alerts - Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=your-email@gmail.com

# Trading Configuration
INITIAL_CAPITAL=5000.0
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_PCT=20.0
MAX_OPEN_POSITIONS=10
MIN_CASH_RESERVE_PCT=30.0

# Domain (for SSL certificate)
DOMAIN=trader.yourdomain.com
